<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 31 and higher. Keep in sync with backup_rules.xml.
   Only app data is included. Third-party SDK state must not be restored on a new device: Firebase Auth
   stores its session encrypted with an Android Keystore key, which is never backed up nor transferred,
   so a restored session can't be decrypted and breaks login.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sevibus" />
        <include domain="database" path="sevibus-wal" />
        <include domain="file" path="datastore/night_mode_prefs.preferences_pb" />
        <include domain="file" path="datastore/analytics_prefs.preferences_pb" />
        <include domain="file" path="datastore/app_start_tracking_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sevibus" />
        <include domain="database" path="sevibus-wal" />
        <include domain="file" path="datastore/night_mode_prefs.preferences_pb" />
        <include domain="file" path="datastore/analytics_prefs.preferences_pb" />
        <include domain="file" path="datastore/app_start_tracking_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
